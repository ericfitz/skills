.venv/
__pycache__/
*.pyc
*.egg-info/
.DS_Store
.envrc
.ruff_cache/

# Calibration corpus and per-run outputs — mostly third-party /
# copyrighted source documents and large CSV artifacts we use locally
# to tune thresholds. Not for the public repo. The tooling
# (writing/skills/boring/tools/*.py) IS tracked — only the calibration
# data directory and per-run output files are ignored.
writing/skills/boring/calibration/

# Built skill output — produced by copying the skill src into a
# distributable tree. Regenerated; not tracked.
writing/skills/boring/dist/

# IDE local state
.vscode/

# Agent-created git worktrees must never be committed (stray gitlinks)
.claude/worktrees/

# Machine-local, non-tracked config and cache (per the .local/ convention):
# e.g. sem-scope.json, sem.db, project caches, and SDD progress/reports.
.local/

# subagent-driven-development scratch workspace
.superpowers/
